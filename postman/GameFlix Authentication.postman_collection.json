{
  "info": {
    "_postman_id": "c2963cc2-38f5-44f2-9b88-911e55b57c77",
    "name": "GameFlix Authentication",
    "description": "Required success and failure tests for GameFlix registration, login, and the protected current-user endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Register member - 201",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nathan.test@example.com\",\n  \"password\": \"ThrowawayPassword123!\",\n  \"firstName\": \"Nathan\",\n  \"lastName\": \"Mueller\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "2 - Duplicate email - 409",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nathan.test@example.com\",\n  \"password\": \"AnotherPassword123!\",\n  \"firstName\": \"Nathan\",\n  \"lastName\": \"Mueller\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "3 - Login success - 200",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "if (pm.response.code === 200) {",
            "    pm.collectionVariables.set('token', pm.response.json().token);",
            "}"
          ],
          "type": "text/javascript"
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nathan.test@example.com\",\n  \"password\": \"ThrowawayPassword123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "4 - Wrong password - 401",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"nathan.test@example.com\",\n  \"password\": \"WrongPassword123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "5 - Current member with valid token - 200",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "6 - Current member with missing token - 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "7 - Current member with tampered token - 401",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}tampered" }],
        "url": "{{baseUrl}}/api/users/me"
      }
    }
  ]
}
